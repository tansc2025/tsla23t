import { useEffect, useState } from 'react';

// Dynamically pull the key based on your build tool
const FINNHUB_KEY = process.env.REACT_APP_FINNHUB_API_KEY || import.meta.env.VITE_FINNHUB_API_KEY;

function StockChart({ symbol }) {
  const [chartData, setChartData] = useState([]);

  useEffect(() => {
    // Example: Fetching daily candles for the past 30 days
    const end = Math.floor(Date.now() / 1000);
    const start = end - 30 * 24 * 60 * 60; 
    
    const url = `https://finnhub.io/api/v1/stock/candle?symbol=${symbol}&resolution=D&from=${start}&to=${end}&token=${FINNHUB_KEY}`;

    fetch(url)
      .then(res => res.json())
      .then(data => {
        if (data.s === "ok") {
          // Format Finnhub's response into array format for candlestick charts
          const formattedData = data.t.map((time, index) => ({
            x: new Date(time * 1000),
            y: [data.o[index], data.h[index], data.l[index], data.c[index]] // Open, High, Low, Close
          }));
          setChartData(formattedData);
        } else {
          console.error("Finnhub returned an error or empty data", data);
        }
      })
      .catch(err => console.error("Failed to fetch live Finnhub data:", err));
  }, [symbol]);

  // Pass chartData to your Candlestick component here...
}
